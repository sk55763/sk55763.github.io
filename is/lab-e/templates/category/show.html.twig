{% extends 'base.html.twig' %}

{% block title %}Szczegóły kategorii{% endblock %}

{% block body %}
    <main class="container py-5">
        <div class="page-header">
            <h1 class="h2 mb-1">Szczegóły kategorii</h1>
            <p class="text-body-secondary mb-0">Dane wybranej kategorii</p>
        </div>

        <div class="card mb-3">
            <div class="table-responsive">
                <table class="table mb-0">
                    <tbody>
                        <tr>
                            <th scope="row">ID</th>
                            <td>{{ category.id }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Tiry</th>
                            <td>{{ category.tiry }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Tirowcy</th>
                            <td>{{ category.tirowcy }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3">
            <a href="{{ path('app_category_index') }}">Powrót do listy</a>
            <a class="btn btn-primary" href="{{ path('app_category_edit', {'id': category.id}) }}">Edytuj</a>
            {{ include('category/_delete_form.html.twig') }}
        </div>
    </main>
{% endblock %}
