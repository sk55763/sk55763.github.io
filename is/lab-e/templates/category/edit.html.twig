{% extends 'base.html.twig' %}

{% block title %}Edycja kategorii{% endblock %}

{% block body %}
    <main class="container py-5">
        <div class="page-header">
            <h1 class="h2 mb-1">Edycja kategorii</h1>
            <p class="text-body-secondary mb-0">Zmień dane kategorii i zapisz formularz.</p>
        </div>

        <div class="card p-4 mb-3">
            {{ include('category/_form.html.twig', {'button_label': 'Zapisz zmiany'}) }}
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <a href="{{ path('app_category_index') }}">Powrót do listy</a>
            {{ include('category/_delete_form.html.twig') }}
        </div>

    </main>
{% endblock %}
